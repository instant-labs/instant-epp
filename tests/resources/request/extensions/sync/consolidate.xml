<!-- Description: Domain update with sync extension -->
<!-- Notes: Sets a custom expiration month and day for domain consolidation -->
<!-- Namespace: http://www.verisign.com/epp/sync-1.0 -->
<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<epp xmlns="urn:ietf:params:xml:ns:epp-1.0">
    <command>
        <update>
            <update xmlns="urn:ietf:params:xml:ns:domain-1.0">
                <name>eppdev.com</name>
                <chg></chg>
            </update>
        </update>
        <extension>
            <update xmlns="http://www.verisign.com/epp/sync-1.0">
                <expMonthDay>--05-31</expMonthDay>
            </update>
        </extension>
        <clTRID>cltrid:1626454866</clTRID>
    </command>
</epp>
